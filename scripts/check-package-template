#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0 WITH Swift-exception
"""Compare a package template's documentation with the minimal profile export."""

import argparse
import difflib
import os
from pathlib import Path
import shutil
import subprocess
import sys


ROOT = Path(__file__).resolve().parent.parent


def check(template_root: Path, export_root: Path) -> int:
    exported = subprocess.run([
        sys.executable, "-B", str(ROOT / "skills/swiftpm-docs/scripts/export_profile.py"),
        "--profile", "minimal", "--package-root", str(template_root),
        "--output", str(export_root), "--set", "repo-name=swift-package-template",
        "--set", "package-name=swift-package-template",
    ])
    if exported.returncode:
        return exported.returncode

    different = False
    for path in sorted(export_root.rglob("*")):
        if not path.is_file():
            continue
        relative = path.relative_to(export_root)
        target = template_root / relative
        expected = path.read_bytes()
        try:
            actual = target.read_bytes()
        except FileNotFoundError:
            print(f"{target}: missing file", file=sys.stderr)
            actual = b""
            different = True
        if actual != expected:
            different = True
            sys.stdout.flush()
            sys.stdout.buffer.writelines(difflib.diff_bytes(
                difflib.unified_diff, actual.splitlines(keepends=True),
                expected.splitlines(keepends=True), fromfile=os.fsencode(target),
                tofile=os.fsencode(path),
            ))
    return 1 if different else 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("template_dir", type=Path)
    args = parser.parse_args()
    temporary_root = Path(os.environ.get("RUNNER_TEMP", ROOT / ".build/package-template"))
    export_root = temporary_root / "export"
    try:
        temporary_root.mkdir(parents=True, exist_ok=True)
        export_root.mkdir()
    except OSError as error:
        print(error, file=sys.stderr)
        return 1
    try:
        return check(args.template_dir, export_root)
    except OSError as error:
        print(error, file=sys.stderr)
        return 1
    finally:
        shutil.rmtree(export_root)


if __name__ == "__main__":
    sys.exit(main())
